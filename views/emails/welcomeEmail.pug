doctype html
html
  head
    meta(charset='UTF-8')
    meta(name='viewport', content='width=device-width, initial-scale=1.0')
    title Welcome to #{appName}
  body(style='margin:0; padding:0; background-color:#f8fafc; font-family: "Segoe UI", Roboto, Helvetica, Arial, sans-serif; color:#1e293b;')
    table(role='presentation', width='100%', cellspacing='0', cellpadding='0', style='background-color:#f8fafc; padding:40px 16px;')
      tr
        td(align='center')
          table(role='presentation', width='100%', cellspacing='0', cellpadding='0', style='max-width:600px; background:#ffffff; border-radius:24px; overflow:hidden; box-shadow:0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);')
            
            //- Header Section
            tr
              td(style='padding:50px 40px; background: linear-gradient(135deg, #2563eb 0%, #7c3aed 100%); color:#ffffff; text-align:center;')
                p(style='margin:0 0 12px; letter-spacing:0.2em; text-transform:uppercase; font-size:13px; font-weight:700; opacity:0.9;') Your Adventure Begins
                h1(style='margin:0; font-size:36px; font-weight:800; line-height:1.2;') Welcome, #{name}!
            
            //- Body Content
            tr
              td(style='padding:40px 40px 20px;')
                p(style='margin:0 0 20px; font-size:18px; line-height:1.6; color:#334155;') We're thrilled to help you explore the world. Your #[b(style='font-weight: 700;') #{appName}] account is officially active.
                
                //- Features / Value Props
                table(role='presentation', width='100%', cellspacing='0', cellpadding='0' style='margin-bottom: 30px;')
                  tr
                    td(style='padding:15px; background:#f1f5f9; border-radius:12px;')
                      p(style='margin:0; font-size:15px; color:#475569;') ✈️ #[b Plan] Flights, Hotels, and Trains in one dashboard.
                  tr
                    td(style='padding:5px;')
                  tr
                    td(style='padding:15px; background:#f1f5f9; border-radius:12px;')
                      p(style='margin:0; font-size:15px; color:#475569;') 📍 #[b Discover:] Local hidden gems and top-rated stays.

                p(style='margin:0 0 30px; font-size:16px; line-height:1.6; color:#475569;') Ready to map out your next escape? Let's get started.

            //- CTA Button
            tr
              td(style='padding:0 40px 40px; text-align:center;')
                a(href=frontendBaseUrl style='display:inline-block; background-color:#2563eb; color:#ffffff; padding:16px 36px; border-radius:12px; font-size:16px; font-weight:600; text-decoration:none; box-shadow: 0 4px 6px -1px rgba(37, 99, 235, 0.2);') Start Planning Your Trip

            //- Footer Section
            tr
              td(style='padding:30px 40px; background:#f8fafc; border-top:1px solid #e2e8f0; text-align:center;')
                p(style='margin:0; font-size:14px; color:#64748b;') Cheers to new horizons,
                p(style='margin:4px 0 0; font-size:16px; font-weight:700; color:#1e293b;') The #{appName} Team
                
                div(style='margin-top:20px; border-top:1px solid #e2e8f0; padding-top:20px;')
                  p(style='margin:0; font-size:12px; color:#94a3b8;') If you didn't create an account, you can safely ignore this email.