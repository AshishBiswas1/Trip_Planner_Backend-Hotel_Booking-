doctype html
html
  head
    meta(charset='UTF-8')
    meta(name='viewport', content='width=device-width, initial-scale=1.0')
    title Reset Your Password - #{appName}
  body(style='margin:0; padding:0; background-color:#f8fafc; font-family: "Segoe UI", Roboto, Helvetica, Arial, sans-serif; color:#1e293b;')
    table(role='presentation', width='100%', cellspacing='0', cellpadding='0', style='background-color:#f8fafc; padding:40px 16px;')
      tr
        td(align='center')
          table(role='presentation', width='100%', cellspacing='0', cellpadding='0', style='max-width:600px; background:#ffffff; border-radius:24px; overflow:hidden; box-shadow:0 20px 25px -5px rgba(0, 0, 0, 0.1);')
            
            //- Header Section
            tr
              td(style='padding:40px 40px 10px; text-align:center;')
                div(style='display:inline-block; background-color:#f1f5f9; padding:12px; border-radius:50%; margin-bottom:16px;')
                  //- Simple Lock Emoji acting as an icon
                  span(style='font-size:32px;') 🔒
                h1(style='margin:0; font-size:28px; font-weight:800; color:#0f172a;') Forgot your password?
            
            //- Body Content
            tr
              td(style='padding:20px 40px 30px; text-align:center;')
                p(style='margin:0 0 16px; font-size:16px; line-height:1.6; color:#475569;') Hi #{name}, 
                p(style='margin:0 0 24px; font-size:16px; line-height:1.6; color:#475569;') We received a request to reset the password for your **#{appName}** account. No changes have been made yet.
                p(style='margin:0; font-size:16px; line-height:1.6; color:#475569;') Click the button below to set up a new password:

            //- Action Button
            tr
              td(style='padding:0 40px 30px; text-align:center;')
                a(href=`${resetUrl}` style='display:inline-block; background-color:#2563eb; color:#ffffff; padding:16px 40px; border-radius:12px; font-size:16px; font-weight:700; text-decoration:none; box-shadow: 0 4px 6px -1px rgba(37, 99, 235, 0.2);') Reset Password

            //- Security Note & Fallback Link
            tr
              td(style='padding:0 40px 40px;')
                div(style='padding:20px; background-color:#fefce8; border-radius:12px; border:1px solid #fef08a;')
                  p(style='margin:0 0 8px; font-size:13px; font-weight:700; color:#854d0e; text-transform:uppercase;') Security Notice
                  p(style='margin:0 0 12px; font-size:14px; line-height:1.5; color:#713f12;') This link will expire in 1 hour. If you did not request this, you can safely ignore this email; your account remains secure.
                  
                  p(style='margin:12px 0 4px; font-size:12px; color:#a16207;') Button not working? Copy and paste this link:
                  p(style='margin:0; font-size:12px; word-break:break-all;')
                    a(href=`${resetUrl}` style='color:#2563eb; text-decoration:underline;') #{resetUrl}

            //- Simple Footer
            tr
              td(style='padding:30px 40px; background:#f8fafc; border-top:1px solid #e2e8f0; text-align:center;')
                p(style='margin:0; font-size:14px; color:#64748b;') The #{appName} Team